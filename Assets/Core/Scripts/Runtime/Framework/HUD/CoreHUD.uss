/* CSS Variables */
:root {
    --color-progressbar-background: rgba(16, 16, 16, 0.75);
    --color-progressbar-border-color: rgba(0, 0, 0, 0);
    --color-progressbar-fill: rgba(145, 213, 97, 0.75);
    --color-progressbar-text: rgb(255, 255, 255);
    --color-progressbar-text-low: rgb(255, 0, 0);
    --color-progressbar-ammo-blue: rgba(19, 181, 231, 0.75);
}

/* Root Container */
#hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* Health Info Container */
/* Health Info Container - Compact & Minimal */
#health-info-container {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: auto;
    background-color: rgba(10, 12, 16, 0.70);
    padding: 6px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    width: 180px;
}

.hud-stat-group {
    flex-direction: column;
}

.hud-stat-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.hud-stat-title {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.hp-title {
    color: rgb(85, 230, 130);
}

.stamina-title {
    color: rgb(255, 175, 55);
}

.hud-stat-value {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

/* Progress Bars - Slim Modern Style */
#player-health-bar,
#player-stamina-bar {
    width: 100%;
    height: 6px;
    min-height: 6px;
    max-height: 6px;
    flex-shrink: 0;
    justify-content: center;
}

#health-info-container .unity-progress-bar {
    min-height: 6px;
    max-height: 6px;
    height: 6px;
    background-color: rgba(18, 20, 24, 0.8);
    border-radius: 3px;
    border-width: 0px;
}

#health-info-container .unity-progress-bar__background {
    min-height: 6px;
    max-height: 6px;
    height: 6px;
    border-radius: 3px;
    border-width: 0px;
    background-color: rgba(22, 24, 30, 0.75);
}

#health-info-container .unity-progress-bar__progress {
    height: 6px;
    border-radius: 2px;
    margin: 0px;
}

#health-info-container .unity-progress-bar__title {
    display: none;
}

/* Notification Styles */
.notification-container {
    position: absolute;
    top: 20px;
    right: 20px;
    flex-direction: column;
    min-width: 200px;
    max-width: 350px;
    max-height: 200px;
}

.notification-item {
    flex-direction: column;
    background-color: rgba(22, 22, 24, 0.9);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 6px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.notification-item Label {
    color: rgb(229, 229, 229);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.notification-fade-out {
    opacity: 0;
}

/* Message Overlay */
#message-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#message-label {
    font-size: 28px;
    color: white;
    -unity-font-style: bold;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
    margin-bottom: 12px;
}

#message-divider {
    width: 194px;
    height: 4px;
    background-color: white;
    margin-bottom: -10px;
    align-self: center;
}

#countdown-label {
    font-size: 150px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: -5px;
}

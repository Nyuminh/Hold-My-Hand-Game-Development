/* ============================================================
   TutorialHUD.uss — Sleek in-game HUD overlay for Tutorial Scene
   ============================================================ */

#tutorial-hud-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    justify-content: space-between;
    padding: 24px 28px;
}

/* ── Top Bar ─────────────────────────────────────────────────── */
.tutorial-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

/* ── Guide Card (Top-Left) ──────────────────────────────────── */
.tutorial-guide-card {
    background-color: rgba(10, 12, 18, 0.88);
    padding: 16px 20px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    width: 320px;
}

.guide-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.header-icon {
    font-size: 26px;
    margin-right: 12px;
}

.tutorial-title-label {
    font-size: 13px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tutorial-role-badge {
    font-size: 12px;
    color: rgb(245, 195, 60);
    -unity-font-style: bold;
    margin-top: 2px;
}

.guide-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 8px;
    margin-bottom: 10px;
}

.controls-title-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.control-item {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.key-badge {
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(230, 230, 230);
    font-size: 11px;
    -unity-font-style: bold;
    padding: 2px 7px;
    border-radius: 0;
    margin-right: 10px;
    width: 78px;
    -unity-text-align: middle-center;
}

.key-highlight {
    background-color: rgba(245, 195, 60, 0.25);
    color: rgb(255, 215, 90);
    border-width: 1px;
    border-color: rgba(245, 195, 60, 0.6);
}

.control-desc {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
}

.highlight-text {
    color: rgb(255, 220, 110);
    -unity-font-style: bold;
}

/* ── Actions Panel (Top-Right) ──────────────────────────────── */
.tutorial-actions-panel {
    align-items: flex-end;
}

.action-btn {
    height: 40px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-radius: 0;
    border-width: 1px;
    padding: 0 18px;
    margin-bottom: 8px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.switch-btn {
    background-color: rgba(40, 140, 220, 0.25);
    border-color: rgba(80, 180, 255, 0.5);
    color: rgb(160, 225, 255);
}

.switch-btn:hover {
    background-color: rgba(40, 140, 220, 0.45);
    border-color: rgb(120, 210, 255);
    color: rgb(255, 255, 255);
    scale: 1.02;
}

.switch-btn:active {
    scale: 0.98;
}

.lobby-btn {
    background-color: rgba(220, 50, 50, 0.22);
    border-color: rgba(255, 80, 80, 0.4);
    color: rgb(255, 160, 160);
}

.lobby-btn:hover {
    background-color: rgba(220, 50, 50, 0.42);
    border-color: rgb(255, 100, 100);
    color: rgb(255, 255, 255);
    scale: 1.02;
}

.lobby-btn:active {
    scale: 0.98;
}

/* ── Bottom Tips ────────────────────────────────────────────── */
.bottom-tips-container {
    align-items: center;
    margin-bottom: 8px;
}

.tips-box {
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 12, 18, 0.88);
    padding: 8px 24px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgba(245, 195, 60, 0.3);
}

.tips-prefix {
    font-size: 12px;
    color: rgb(245, 195, 60);
    -unity-font-style: bold;
    margin-right: 6px;
}

.tips-content {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.85);
}


/* ── Objective Panel (Tutorial Objective Director) ───────────── */
.objective-panel {
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.compass-arrow {
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
    transition-property: rotate;
    transition-duration: 0.1s;
}

.compass-arrow-icon {
    font-size: 22px;
    color: rgb(245, 195, 60);
    -unity-font-style: bold;
}

.objective-card {
    background-color: rgba(10, 14, 24, 0.92);
    border-width: 1px;
    border-color: rgba(245, 195, 60, 0.45);
    border-radius: 8px;
    padding: 12px 24px;
    min-width: 380px;
    max-width: 600px;
    align-items: center;
}

.objective-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.objective-icon {
    font-size: 16px;
    margin-right: 6px;
}

.objective-section-label {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: rgba(245, 195, 60, 0.9);
    -unity-font-style: bold;
}

.objective-title {
    font-size: 15px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.objective-hint {
    font-size: 11px;
    color: rgba(200, 215, 240, 0.85);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.objective-keys-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
}

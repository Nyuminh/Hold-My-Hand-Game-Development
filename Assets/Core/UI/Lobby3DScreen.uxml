<engine:UXML xmlns:engine="UnityEngine.UIElements" editor-extension-mode="False">
    <engine:VisualElement name="lobby3d-root" picking-mode="Ignore" style="flex-grow: 1; background-color: transparent;">
        <engine:VisualElement picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; padding: 20px;">
            <engine:VisualElement picking-mode="Position" style="background-color: rgba(15, 15, 25, 0.75); padding: 12px 20px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.08); flex-direction: row; align-items: center;">
                <engine:Label text="👤" style="font-size: 24px; margin-right: 10px;"/>
                <engine:VisualElement>
                    <engine:Label name="player-name-label" text="Hello, Player!" style="font-size: 16px; color: white; -unity-font-style: bold;"/>
                    <engine:Label name="player-role-label" text="Role: ---" style="font-size: 12px; color: rgba(255, 255, 255, 0.5); margin-top: 2px;"/>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="room-info-panel" picking-mode="Position" style="display: none; background-color: rgba(15, 15, 25, 0.75); padding: 12px 20px; border-radius: 12px; border-width: 1px; border-color: rgba(100, 200, 255, 0.2); align-items: flex-end;">
                <engine:Label text="MÃ PHÒNG" style="font-size: 10px; color: rgba(255, 255, 255, 0.4); letter-spacing: 1px;"/>
                <engine:VisualElement style="flex-direction: row; align-items: center; margin-top: 4px;">
                    <engine:Label name="room-code-label" text="------" style="font-size: 28px; color: rgb(100, 200, 255); -unity-font-style: bold; letter-spacing: 3px; margin-right: 8px;"/>
                    <engine:Button name="copy-code-button" text="📋" style="width: 32px; height: 32px; border-radius: 6px; background-color: rgba(255, 255, 255, 0.1); border-width: 0; color: white; font-size: 14px;"/>
                </engine:VisualElement>
                <engine:Label name="room-status-label" text="Đang chờ..." style="font-size: 12px; color: rgb(255, 200, 100); margin-top: 4px;"/>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement picking-mode="Ignore" style="flex-grow: 1;"/>
        <engine:VisualElement picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; align-items: flex-end; padding: 24px;">
            <engine:VisualElement name="session-list-panel" picking-mode="Position" style="display: none; background-color: rgba(15, 15, 25, 0.85); padding: 16px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.08); width: 380px; max-height: 300px;">
                <engine:Label text="DANH SÁCH PHÒNG" style="font-size: 14px; color: white; -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 12px;"/>
                <engine:ScrollView name="session-scroll" style="flex-grow: 1; max-height: 200px;">
                    <engine:Label name="no-sessions-label" text="Chưa có phòng nào..." style="font-size: 13px; color: rgba(255, 255, 255, 0.4); -unity-text-align: middle-center; padding: 20px;"/>
                </engine:ScrollView>
                <engine:VisualElement style="flex-direction: row; margin-top: 12px;">
                    <engine:Button name="refresh-sessions-button" text="🔄 LÀM MỚI" style="flex-grow: 1; height: 36px; font-size: 13px; background-color: rgba(255, 255, 255, 0.1); color: white; border-radius: 6px; border-width: 0; margin-right: 8px;"/>
                    <engine:Button name="close-sessions-button" text="✕ ĐÓNG" style="height: 36px; font-size: 13px; background-color: rgba(255, 50, 50, 0.15); color: rgb(255, 120, 120); border-radius: 6px; border-width: 0; padding: 0 16px;"/>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="bottom-left-spacer" picking-mode="Ignore" style="flex-grow: 1;"/>
            <engine:VisualElement picking-mode="Position" style="align-items: flex-end;">
                <engine:VisualElement name="join-code-panel" style="display: none; background-color: rgba(15, 15, 25, 0.85); padding: 16px; border-radius: 12px; border-width: 1px; border-color: rgba(100, 150, 255, 0.3); margin-bottom: 12px; width: 320px;">
                    <engine:Label text="NHẬP MÃ PHÒNG" style="font-size: 12px; color: rgba(255, 255, 255, 0.5); letter-spacing: 1px; margin-bottom: 8px;"/>
                    <engine:TextField name="join-code-input" style="font-size: 20px; -unity-text-align: middle-center; letter-spacing: 3px; height: 44px; margin-bottom: 12px;"/>
                    <engine:VisualElement style="flex-direction: row;">
                        <engine:Button name="confirm-join-button" text="THAM GIA" style="flex-grow: 1; height: 40px; font-size: 14px; -unity-font-style: bold; background-color: rgb(60, 120, 220); color: white; border-radius: 8px; border-width: 0; margin-right: 8px;"/>
                        <engine:Button name="cancel-join-button" text="HỦY" style="height: 40px; font-size: 14px; background-color: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.6); border-radius: 8px; border-width: 0; padding: 0 20px;"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="main-buttons-panel" style="align-items: flex-end;">
                    <engine:Button name="create-room-button" text="Create" style="width: 260px; height: 50px; font-size: 16px; -unity-font-style: bold; letter-spacing: 1px; background-color: rgb(240, 160, 40); color: white; border-radius: 10px; border-width: 0; margin-bottom: 10px;"/>
                    <engine:VisualElement style="flex-direction: row;">
                        <engine:Button name="join-room-button" text="Join" style="width: 160px; height: 44px; font-size: 13px; -unity-font-style: bold; background-color: rgba(60, 120, 220, 0.3); color: rgb(150, 200, 255); border-radius: 8px; border-width: 1px; border-color: rgba(100, 150, 255, 0.3); margin-right: 8px;"/>
                        <engine:Button name="browse-sessions-button" text="Find" style="width: 120px; height: 44px; font-size: 13px; -unity-font-style: bold; background-color: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.6); border-radius: 8px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="lobby-buttons-panel" style="display: none; align-items: flex-end;">
                    <engine:Button name="play-button" text="▶  PLAY" style="width: 280px; height: 60px; font-size: 22px; -unity-font-style: bold; letter-spacing: 2px; background-color: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.3); border-radius: 12px; border-width: 0; margin-bottom: 10px;"/>
                    <engine:VisualElement style="flex-direction: row;">
                        <engine:Button name="swap-role-button" text="🔄 ĐỔI VAI" style="height: 40px; font-size: 13px; -unity-font-style: bold; background-color: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.6); border-radius: 8px; border-width: 0; padding: 0 16px; margin-right: 8px;"/>
                        <engine:Button name="leave-room-button" text="✕ RỜI PHÒNG" style="height: 40px; font-size: 13px; -unity-font-style: bold; background-color: rgba(255, 50, 50, 0.15); color: rgb(255, 120, 120); border-radius: 8px; border-width: 0; padding: 0 16px;"/>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 50%; align-items: center;"/>
    </engine:VisualElement>
</engine:UXML>

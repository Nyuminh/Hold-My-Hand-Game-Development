<engine:UXML xmlns:engine="UnityEngine.UIElements" editor-extension-mode="False">
    <engine:Style src="project://database/Assets/Core/UI/TutorialHUD.uss?fileID=7433441132597879392&amp;guid=e91823746a81bb34cb1999e81b238ef1&amp;type=3#TutorialHUD"/>
    <engine:VisualElement name="tutorial-hud-root" picking-mode="Ignore">
        <!-- Top Bar -->
        <engine:VisualElement class="tutorial-top-bar" picking-mode="Ignore">
            <!-- Left Info & Controls Card -->
            <engine:VisualElement class="tutorial-guide-card" picking-mode="Position">
                <engine:VisualElement class="guide-header-row">
                    <engine:Label text="🎓" class="header-icon"/>
                    <engine:VisualElement>
                        <engine:Label text="BẢN ĐỒ TẬP LUYỆN (TUTORIAL)" class="tutorial-title-label"/>
                        <engine:Label name="role-badge-label" text="Đang điều khiển: 🧔 BA (DAD)" class="tutorial-role-badge"/>
                    </engine:VisualElement>
                </engine:VisualElement>

                <engine:VisualElement class="guide-divider"/>

                <engine:Label text="HƯỚNG DẪN THAO TÁC:" class="controls-title-label"/>
                <engine:VisualElement class="control-item">
                    <engine:Label text="W, A, S, D" class="key-badge"/>
                    <engine:Label text="Di chuyển nhân vật" class="control-desc"/>
                </engine:VisualElement>
                <engine:VisualElement class="control-item">
                    <engine:Label text="Left Shift" class="key-badge"/>
                    <engine:Label text="Chạy nước rút (Sprint)" class="control-desc"/>
                </engine:VisualElement>
                <engine:VisualElement class="control-item">
                    <engine:Label text="Space" class="key-badge"/>
                    <engine:Label text="Nhảy cao" class="control-desc"/>
                </engine:VisualElement>
                <engine:VisualElement class="control-item">
                    <engine:Label text="Mouse" class="key-badge"/>
                    <engine:Label text="Xoay góc nhìn camera" class="control-desc"/>
                </engine:VisualElement>
                <engine:VisualElement class="control-item">
                    <engine:Label text="Phím T" class="key-badge key-highlight"/>
                    <engine:Label text="Đổi vai: Ba ↔ Con" class="control-desc highlight-text"/>
                </engine:VisualElement>
                <engine:VisualElement class="control-item">
                    <engine:Label text="ESC" class="key-badge"/>
                    <engine:Label text="Menu tạm dừng / Thoát" class="control-desc"/>
                </engine:VisualElement>
            </engine:VisualElement>

            <!-- Right Action Buttons -->
            <engine:VisualElement class="tutorial-actions-panel" picking-mode="Position">
                <engine:Button name="switch-role-btn" text="🔄  ĐỔI VAI: BA ↔ CON [T]" class="action-btn switch-btn"/>
                <engine:Button name="return-lobby-btn" text="🏠  TRỞ VỀ SẢNH" class="action-btn lobby-btn"/>
            </engine:VisualElement>
        </engine:VisualElement>

        <!-- Bottom Tips Banner -->
        <engine:VisualElement class="bottom-tips-container" picking-mode="Ignore">
            <engine:VisualElement class="tips-box" picking-mode="Position">
                <engine:Label text="💡 BÀI TẬP: " class="tips-prefix"/>
                <engine:Label text="1. Tập chạy &amp; nhảy vượt chướng ngại  |  2. Bệ nhún đẩy vọt lên cao  |  3. Đổi qua lại Ba &amp; Con để cảm nhận sự khác biệt!" class="tips-content"/>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>

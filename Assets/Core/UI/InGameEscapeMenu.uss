/* ============================================================
   InGameEscapeMenu.uss — Pause & Escape Menu UI
   Theme: Frameless Dark Glassmorphism, Sharp Corners, Amber Accent
   ============================================================ */

.escape-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 8, 14, 0.80);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.escape-modal-card {
    width: 360px;
    background-color: rgba(10, 12, 18, 0.92);
    border-radius: 0;
    border-width: 0;
    padding: 24px 26px;
    align-items: center;
}

.escape-header {
    align-items: center;
    margin-bottom: 4px;
}

.escape-title {
    font-size: 18px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
}

.escape-subtitle {
    font-size: 11px;
    color: rgb(240, 180, 50);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.escape-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(240, 180, 50, 0.22);
    margin-top: 8px;
    margin-bottom: 12px;
}

.escape-status {
    font-size: 12px;
    color: rgba(220, 230, 255, 0.75);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.escape-button-group {
    width: 100%;
    align-items: stretch;
}

.btn-escape-resume {
    height: 40px;
    background-color: rgb(230, 170, 40);
    color: rgb(20, 15, 5);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-radius: 0;
    border-width: 0;
    margin-bottom: 10px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.btn-escape-resume:hover {
    background-color: rgb(245, 190, 55);
    scale: 1.02;
}

.btn-escape-resume:active {
    background-color: rgb(200, 145, 25);
    scale: 0.98;
}

.btn-escape-lobby {
    height: 38px;
    background-color: rgba(220, 50, 50, 0.20);
    color: rgb(255, 120, 120);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-radius: 0;
    border-width: 0;
    transition-property: background-color, color, scale;
    transition-duration: 0.15s;
}

.btn-escape-lobby:hover {
    background-color: rgba(220, 50, 50, 0.38);
    color: rgb(255, 255, 255);
    scale: 1.02;
}

.btn-escape-lobby:active {
    background-color: rgba(220, 50, 50, 0.55);
    scale: 0.98;
}

.escape-hint {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    margin-top: 14px;
    -unity-text-align: middle-center;
}

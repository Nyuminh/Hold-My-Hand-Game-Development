/* ============================================================
   InGameEscapeMenu.uss — Pause & Escape Menu UI
   Theme: Dark Glassmorphism with Amber & Crimson Accents
   ============================================================ */

.escape-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 8, 14, 0.78);
    justify-content: center;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.escape-modal-card {
    width: 460px;
    background-color: rgba(14, 18, 30, 0.92);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(240, 180, 50, 0.4);
    padding: 32px 36px;
    align-items: center;
}

.escape-header {
    align-items: center;
    margin-bottom: 8px;
}

.escape-title {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.escape-subtitle {
    font-size: 13px;
    color: rgb(240, 180, 50);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.escape-divider {
    width: 100%;
    height: 1.5px;
    background-color: rgba(255, 255, 255, 0.12);
    margin-top: 12px;
    margin-bottom: 16px;
}

.escape-status {
    font-size: 14px;
    color: rgba(220, 230, 255, 0.85);
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.escape-button-group {
    width: 100%;
    align-items: stretch;
}

.btn-escape-resume {
    height: 52px;
    background-color: rgb(240, 180, 50);
    color: rgb(15, 20, 30);
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 12px;
    border-width: 0;
    margin-bottom: 14px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

.btn-escape-resume:hover {
    background-color: rgb(255, 200, 75);
    scale: 1.02;
}

.btn-escape-resume:active {
    background-color: rgb(215, 155, 30);
    scale: 0.98;
}

.btn-escape-lobby {
    height: 50px;
    background-color: rgba(220, 50, 50, 0.15);
    color: rgb(255, 100, 100);
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(220, 50, 50, 0.5);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.btn-escape-lobby:hover {
    background-color: rgba(220, 50, 50, 0.35);
    border-color: rgb(255, 90, 90);
    color: rgb(255, 255, 255);
    scale: 1.02;
}

.btn-escape-lobby:active {
    background-color: rgba(220, 50, 50, 0.5);
    scale: 0.98;
}

.escape-hint {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 22px;
    -unity-text-align: middle-center;
}

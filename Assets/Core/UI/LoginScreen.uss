/* ============================================================
   LoginScreen.uss — Premium "Hold My Hand" Login UI
   ============================================================ */

/* ── Root Container ─────────────────────────────────────────── */
#main-container {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: flex-start;
    padding-left: 45px;
    padding-bottom: 25px;
    padding-top: 0;
    padding-right: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* ── Glass Card ─────────────────────────────────────────────── */
#glass-card {
    width: 270px;
    padding: 16px 18px;
    border-radius: 0;
    background-color: rgba(10, 12, 18, 0.85);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    align-items: stretch;
}

/* ── Title / Logo Area (Ẩn để không che logo nền) ───────────── */
#title-container {
    display: none;
}

.title-main {
    font-size: 16px;
    color: rgb(245, 195, 60);
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.title-sub {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.50);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-top: 2px;
    margin-bottom: 8px;
}

/* ── Decorative Divider (Ẩn để form thấp và gọn) ─────────────── */
.divider {
    display: none;
}

/* ── Form Labels ────────────────────────────────────────────── */
.field-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 3px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

/* ── Input Field Wrapper ────────────────────────────────────── */
.input-wrapper {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 0;
    border-width: 0;
    padding-left: 8px;
    margin-bottom: 10px;
    height: 34px;
}

.input-wrapper:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

/* Icon inside input */
.input-icon {
    font-size: 13px;
    color: rgba(240, 180, 50, 0.75);
    margin-right: 6px;
    width: 18px;
    -unity-text-align: middle-center;
}

/* The actual TextField inside the wrapper */
.input-field {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(235, 235, 240);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    height: 100%;
    margin: 0;
    padding: 0 6px 0 0;
}

/* Remove Unity default TextField visuals */
.input-field > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(235, 235, 240);
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
}

.input-field:focus > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ── Login Button (Primary CTA) ─────────────────────────────── */
#login-button {
    height: 36px;
    background-color: rgb(230, 170, 40);
    color: rgb(20, 15, 5);
    border-radius: 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-width: 0;
    margin-top: 4px;
    transition-duration: 0.2s;
    transition-property: background-color, scale;
}

#login-button:hover {
    background-color: rgb(245, 190, 55);
    scale: 1.02 1.02;
}

#login-button:active {
    background-color: rgb(200, 145, 25);
    scale: 0.98 0.98;
}

#login-button:disabled {
    background-color: rgba(230, 170, 40, 0.40);
    color: rgba(20, 15, 5, 0.50);
}

/* ── Play Button (After Login) ──────────────────────────────── */
#play-button {
    height: 38px;
    background-color: rgb(230, 170, 40);
    color: rgb(20, 15, 5);
    border-radius: 0;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-width: 0;
    margin-bottom: 10px;
    transition-duration: 0.2s;
    transition-property: background-color, scale;
}

#play-button:hover {
    background-color: rgb(245, 190, 55);
    scale: 1.02 1.02;
}

#play-button:active {
    background-color: rgb(200, 145, 25);
    scale: 0.98 0.98;
}

/* ── Logout Button ──────────────────────────────────────────── */
#logout-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 0;
    color: rgba(255, 255, 255, 0.50);
    font-size: 11px;
    height: 26px;
    align-self: center;
    padding: 0 14px;
    transition-duration: 0.15s;
    transition-property: color, border-color;
}

#logout-button:hover {
    color: rgba(255, 100, 100, 0.90);
    border-color: rgba(255, 100, 100, 0.40);
}

/* ── Welcome Label (Logged In) ──────────────────────────────── */
#welcome-label {
    font-size: 15px;
    color: rgb(245, 195, 60);
    -unity-font-style: bold;
    margin-bottom: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ── Logged In State Container ──────────────────────────────── */
#logged-in-state {
    display: none;
    align-items: stretch;
}

/* ── Status / Error Label ───────────────────────────────────── */
#status-label {
    color: rgb(255, 120, 100);
    -unity-text-align: middle-center;
    margin-top: 8px;
    font-size: 11px;
    white-space: normal;
}

/* ── Footer Text ────────────────────────────────────────────── */
.footer-text {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.30);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ── Version Tag ────────────────────────────────────────────── */
.version-tag {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.20);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

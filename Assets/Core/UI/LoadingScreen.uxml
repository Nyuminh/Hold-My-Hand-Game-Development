    <engine:VisualElement name="loading-root" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(12, 14, 20); background-image: url(&quot;project://database/Assets/Core/UI/load.jpg?fileID=2800000&amp;guid=52c9597a2ed92734cb0106e149b43605&amp;type=3#load&quot;); -unity-background-scale-mode: scale-and-crop; justify-content: flex-end; align-items: center; padding-bottom: 48px;">

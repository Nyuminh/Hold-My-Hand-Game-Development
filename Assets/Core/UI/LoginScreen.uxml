<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <engine:Style src="project://database/Assets/Core/UI/LoginScreen.uss" />

    <engine:VisualElement name="main-container" style="background-image: url(&quot;project://database/Assets/Core/UI/bannerrr.png?fileID=2800000&amp;guid=160a7ae721f5f9d47801a3a9f8f6c17e&amp;type=3#bannerrr&quot;);">

        <engine:VisualElement name="glass-card">

            <!-- ══════ Title Area ══════ -->
            <engine:VisualElement name="title-container">
                <engine:Label text="HOLD MY HAND" class="title-main" />
                <engine:Label text="Welcome back" class="title-sub" />
            </engine:VisualElement>

            <engine:VisualElement class="divider" />

            <!-- ══════ Login Form ══════ -->
            <engine:VisualElement name="login-form">

                <!-- Username -->
                <engine:Label text="USERNAME" class="field-label" />
                <engine:VisualElement class="input-wrapper">
                    <engine:Label text="👤" class="input-icon" />
                    <engine:TextField name="username-input" class="input-field" />
                </engine:VisualElement>

                <!-- Password -->
                <engine:Label text="PASSWORD" class="field-label" />
                <engine:VisualElement class="input-wrapper">
                    <engine:Label text="🔒" class="input-icon" />
                    <engine:TextField name="password-input" password="true" class="input-field" />
                </engine:VisualElement>

                <!-- Login Button -->
                <engine:Button name="login-button" text="ĐĂNG NHẬP" />

            </engine:VisualElement>

            <!-- ══════ Logged-In State ══════ -->
            <engine:VisualElement name="logged-in-state">
                <engine:Label name="welcome-label" text="Xin chào, Player!" />
                <engine:Button name="play-button" text="▶  VÀO GAME" />
                <engine:Button name="logout-button" text="Đăng xuất" />
            </engine:VisualElement>

            <!-- ══════ Status Label ══════ -->
            <engine:Label name="status-label" text="" />

            <!-- ══════ Footer ══════ -->
            <engine:Label text="v1.0 — Hold My Hand" class="version-tag" />

        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>

/* ============================================================
   Lobby3DScreen.uss — Premium 3D Lobby UI for Hold My Hand
   Theme: Dark Glassmorphism with Amber & Cyan Accents
   ============================================================ */

/* ── Root Canvas ────────────────────────────────────────────── */
#lobby3d-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    justify-content: space-between;
}

/* ── Top Header Bar ─────────────────────────────────────────── */
.top-header-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 32px;
}

/* ── Player Profile Card ────────────────────────────────────── */
.player-profile-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 14, 24, 0.82);
    padding: 12px 22px;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(240, 180, 50, 0.25);
    transition-property: border-color, background-color;
    transition-duration: 0.2s;
}

.player-profile-card:hover {
    border-color: rgba(240, 180, 50, 0.5);
    background-color: rgba(18, 22, 38, 0.9);
}

.avatar-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgba(240, 180, 50, 0.15);
    border-width: 1.5px;
    border-color: rgba(240, 180, 50, 0.4);
    justify-content: center;
    align-items: center;
    margin-right: 14px;
}

.avatar-icon-label {
    font-size: 22px;
    -unity-text-align: middle-center;
}

#player-name-label {
    font-size: 17px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

#player-role-label {
    font-size: 13px;
    color: rgb(245, 195, 60);
    margin-top: 3px;
    -unity-font-style: bold;
}

/* ── Room Info Panel (Top Right) ────────────────────────────── */
#room-info-panel {
    align-items: flex-end;
    background-color: rgba(12, 14, 24, 0.88);
    padding: 14px 24px;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(100, 200, 255, 0.35);
}

.room-tag-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.room-code-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

#room-code-label {
    font-size: 32px;
    color: rgb(120, 220, 255);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-right: 12px;
}

#copy-code-button {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background-color: rgba(100, 200, 255, 0.15);
    border-width: 1px;
    border-color: rgba(100, 200, 255, 0.3);
    color: rgb(255, 255, 255);
    font-size: 16px;
    justify-content: center;
    align-items: center;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#copy-code-button:hover {
    background-color: rgba(100, 200, 255, 0.35);
    scale: 1.08;
}

#copy-code-button:active {
    scale: 0.95;
}

#room-status-label {
    font-size: 13px;
    color: rgb(255, 200, 100);
    margin-top: 5px;
    -unity-font-style: bold;
}

/* ── Toast Center Notification ──────────────────────────────── */
.toast-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    align-items: center;
    justify-content: center;
}

#toast-label {
    background-color: rgba(15, 15, 25, 0.92);
    color: rgb(255, 225, 120);
    font-size: 15px;
    -unity-font-style: bold;
    padding: 12px 28px;
    border-radius: 24px;
    border-width: 1.5px;
    border-color: rgba(240, 180, 50, 0.4);
    letter-spacing: 1px;
}

/* ── Bottom Controls Bar ────────────────────────────────────── */
.bottom-controls-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 28px 36px;
}

/* ── Session List Panel (Bottom Left) ───────────────────────── */
#session-list-panel {
    background-color: rgba(12, 14, 24, 0.92);
    padding: 20px;
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.12);
    width: 420px;
    max-height: 320px;
}

.session-title-label {
    font-size: 14px;
    color: rgb(245, 195, 60);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
}

#session-scroll {
    flex-grow: 1;
    max-height: 200px;
    margin-bottom: 14px;
}

#no-sessions-label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: middle-center;
    padding: 24px 12px;
}

.session-button-row {
    flex-direction: row;
}

#refresh-sessions-button {
    flex-grow: 1;
    height: 40px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(255, 255, 255);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    margin-right: 10px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#refresh-sessions-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
    scale: 1.02;
}

#close-sessions-button {
    height: 40px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(255, 60, 60, 0.15);
    color: rgb(255, 130, 130);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 60, 60, 0.3);
    padding: 0 20px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#close-sessions-button:hover {
    background-color: rgba(255, 60, 60, 0.3);
    scale: 1.02;
}

/* ── Join Code Dialog Panel (Bottom Right) ──────────────────── */
#join-code-panel {
    background-color: rgba(12, 14, 24, 0.94);
    padding: 22px;
    border-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(100, 180, 255, 0.35);
    margin-bottom: 14px;
    width: 340px;
}

.dialog-heading-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

#join-code-input {
    font-size: 22px;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    height: 48px;
    margin-bottom: 16px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(100, 180, 255, 0.3);
    color: rgb(255, 255, 255);
}

#join-code-input:hover {
    border-color: rgba(100, 180, 255, 0.6);
}

#join-code-input .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.dialog-button-row {
    flex-direction: row;
}

#confirm-join-button {
    flex-grow: 1;
    height: 44px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgb(50, 120, 230);
    color: rgb(255, 255, 255);
    border-radius: 10px;
    border-width: 0;
    margin-right: 10px;
    letter-spacing: 1px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#confirm-join-button:hover {
    background-color: rgb(70, 140, 250);
    scale: 1.03;
}

#confirm-join-button:active {
    scale: 0.97;
}

#cancel-join-button {
    height: 44px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.65);
    border-radius: 10px;
    border-width: 0;
    padding: 0 22px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#cancel-join-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: rgb(255, 255, 255);
}

/* ── Main Buttons Panel (Not In Room) ───────────────────────── */
#main-buttons-panel {
    align-items: flex-end;
}

#create-room-button {
    width: 290px;
    height: 56px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    background-color: rgb(240, 160, 40);
    color: rgb(255, 255, 255);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 220, 120, 0.4);
    margin-bottom: 12px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#create-room-button:hover {
    background-color: rgb(255, 175, 55);
    scale: 1.03;
    border-color: rgba(255, 240, 180, 0.7);
}

#create-room-button:active {
    scale: 0.97;
}

.secondary-buttons-row {
    flex-direction: row;
}

#join-room-button {
    width: 165px;
    height: 48px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(50, 120, 230, 0.25);
    color: rgb(150, 210, 255);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(100, 170, 255, 0.4);
    margin-right: 10px;
    letter-spacing: 0.5px;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.15s;
}

#join-room-button:hover {
    background-color: rgba(50, 120, 230, 0.45);
    border-color: rgba(140, 200, 255, 0.7);
    color: rgb(255, 255, 255);
    scale: 1.03;
}

#join-room-button:active {
    scale: 0.97;
}

#browse-sessions-button {
    width: 125px;
    height: 48px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.75);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.15);
    letter-spacing: 0.5px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#browse-sessions-button:hover {
    background-color: rgba(255, 255, 255, 0.18);
    color: rgb(255, 255, 255);
    scale: 1.03;
}

#browse-sessions-button:active {
    scale: 0.97;
}

/* ── Lobby Buttons Panel (Inside Room) ──────────────────────── */
#lobby-buttons-panel {
    align-items: flex-end;
}

#play-button {
    width: 300px;
    height: 64px;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.15);
    margin-bottom: 12px;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

#play-button:hover {
    scale: 1.04;
}

#play-button:active {
    scale: 0.97;
}

.in-room-actions-row {
    flex-direction: row;
}

#swap-role-button {
    height: 44px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    padding: 0 20px;
    margin-right: 10px;
    letter-spacing: 0.5px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#swap-role-button:hover {
    background-color: rgba(255, 255, 255, 0.22);
    color: rgb(255, 255, 255);
    scale: 1.03;
}

#swap-role-button:active {
    scale: 0.97;
}

#leave-room-button {
    height: 44px;
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(255, 60, 60, 0.18);
    color: rgb(255, 130, 130);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 60, 60, 0.35);
    padding: 0 20px;
    letter-spacing: 0.5px;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
}

#leave-room-button:hover {
    background-color: rgba(255, 60, 60, 0.35);
    color: rgb(255, 180, 180);
    scale: 1.03;
}

#leave-room-button:active {
    scale: 0.97;
}

<engine:UXML xmlns:engine="UnityEngine.UIElements">
    <engine:VisualElement name="wait-room-root" style="position: absolute; top: 20px; right: 20px; width: 280px; background-color: transparent;">

        <!-- Wait Room Panel (Overlay on top of game) -->
        <engine:VisualElement style="background-color: rgba(10, 12, 18, 0.90); padding: 14px 16px; border-radius: 0; border-width: 0;">

            <engine:Label text="PHÒNG CHỜ"
                style="font-size: 15px; color: rgb(240, 180, 50); -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 10px; -unity-text-align: middle-center;"/>

            <!-- Room Info -->
            <engine:VisualElement style="margin-bottom: 10px; background-color: rgba(255, 255, 255, 0.06); border-radius: 0; border-width: 0; padding: 10px;">
                <engine:Label text="TÊN PHÒNG"
                    style="font-size: 9px; color: rgba(255, 255, 255, 0.5); letter-spacing: 1px; margin-bottom: 2px;"/>
                <engine:Label name="session-name-label" text="Loading..."
                    style="font-size: 14px; color: rgb(120, 220, 255); -unity-font-style: bold; margin-bottom: 6px;"/>
                
                <engine:Label text="NGƯỜI CHƠI"
                    style="font-size: 9px; color: rgba(255, 255, 255, 0.5); letter-spacing: 1px; margin-bottom: 2px;"/>
                <engine:Label name="player-name-label" text="Loading..."
                    style="font-size: 14px; color: white; -unity-font-style: bold;"/>
            </engine:VisualElement>

            <!-- Status & Player Count -->
            <engine:Label name="status-label" text="Đang đợi người chơi thứ 2... (1/2)"
                style="font-size: 11px; color: rgb(255, 200, 100); -unity-text-align: middle-center; margin-bottom: 10px;"/>

            <!-- PLAY Button -->
            <engine:Button name="play-button" text="PLAY"
                style="height: 36px; font-size: 14px; -unity-font-style: bold; letter-spacing: 2px;
                       background-color: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.4);
                       border-radius: 0; border-width: 0;"/>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
